{
  "name": "tempest/app",
  "require": {
    "tempest/framework": "^3.0",
    "laravel/forge-sdk": "^4.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "friendsofphp/php-cs-fixer": "^3.21",
    "symfony/var-dumper": "^7.1",
    "rector/rector": "^2.1",
    "pestphp/pest": "^4.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Brent Roose",
      "email": "brendt@stitcher.io"
    }
  ],
  "scripts": {
    "post-package-update": [
      "./tempest discovery:generate"
    ],
    "pest": "vendor/bin/pest",
    "csfixer": "vendor/bin/php-cs-fixer fix --allow-risky=yes",
    "phpstan": "vendor/bin/phpstan analyse tests app",
    "qa": [
      "composer csfixer",
      "composer phpstan",
      "composer pest"
    ]
  },
  "license": "MIT",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "pestphp/pest-plugin": true
    }
  }
}
